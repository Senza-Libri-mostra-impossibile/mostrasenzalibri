# gitignore lists files you want Git to NOT track!
# Ignore metadata generated by Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore folders generated by Bundler
.bundle/
vendor/

# Ignore mac files
.DS_Store

# Cartella creata dall'app desktop di Claude per i file scaricati in chat;
# non fa parte del sito e non va tracciata nel repository.
Claude outputs/

# temporarily ignore gemfile.lock
Gemfile.lock
